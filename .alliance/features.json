{
  "version": 1,
  "features": [
    {
      "id": "rooms",
      "title": "Rooms and delegation",
      "entryPoint": "Native room creation / create_agent",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "rooms.room-binding",
          "expect": "Native sessions bind the same project room across restart"
        },
        {
          "id": "rooms.assignment",
          "expect": "Retried launches preserve one agent and durable assignment"
        },
        {
          "id": "rooms.ownership",
          "expect": "Cancel/failure/completion preserve ownership without automatic acceptance"
        },
        {
          "id": "rooms.resume",
          "expect": "Resume does not interrupt active work or accept late receipts"
        },
        {
          "id": "rooms.late-owner",
          "expect": "An owner assigned after a session started receives its handback"
        },
        {
          "id": "rooms.wait",
          "expect": "A coordinator waiting on its worker's turn is not continued meanwhile and is woken when that turn ends; an ack closes that reminder unless the turn handed back, which needs a decision"
        },
        {
          "id": "rooms.silence",
          "expect": "A member silent for 20 minutes wakes its idle owner once per incident with how to interrupt it; tracked jobs and Human-owned work only show in status; an unsent notice is withdrawn"
        },
        {
          "id": "rooms.approval",
          "expect": "An Alliance member's approval request is denied 5 minutes after Alliance first saw it (Paseo's hook or the first sweep after a load), with how to redo the step, and never allowed; status shows the denial and the owner gets a pull item, not a wake"
        },
        {
          "id": "rooms.provider-limit",
          "expect": "A Claude limit or API-error notice in a completed turn counts as a failure; a limit holds every prompt to that harness's members on the host until its reset, then each member whose own turn it cut is retried once without budget and a wake batch it cut short is sent again"
        },
        {
          "id": "rooms.launch-env",
          "expect": "Agent sessions launch with input prompts off; the Human's own launches and logins keep theirs"
        },
        {
          "id": "rooms.send-rule",
          "expect": "New agents learn how a send treats a running agent on the connected Paseo daemon"
        }
      ]
    },
    {
      "id": "models",
      "title": "Owner model choice",
      "entryPoint": "Room Models settings",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "models.lead-choice",
          "expect": "Lead can override preferred model and effort"
        },
        {
          "id": "models.worker-policy",
          "expect": "Peer and Lens choices respect their own ordered lists exactly"
        },
        {
          "id": "models.policy-persistence",
          "expect": "Policies persist, reject stale edits, upgrade pre-0.1.18 lists and reset to release defaults, keeping each removed list"
        },
        {
          "id": "models.economical-defaults",
          "expect": "Omitted models use economical owner or standard worker routes; premium selection is deliberate and saved policies remain authoritative"
        },
        {
          "id": "models.agy-gemini",
          "expect": "AGY runs only Gemini models: no role launches another and the Models page neither offers nor saves one"
        }
      ]
    },
    {
      "id": "skills",
      "title": "Project skills",
      "entryPoint": "alliance-work skills add",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "skills.skill-selection",
          "expect": "Only explicitly registered project skills and resources load"
        }
      ]
    },
    {
      "id": "evidence",
      "title": "Bound acceptance",
      "entryPoint": "alliance-work verify / accept",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "evidence.evidence-binding",
          "expect": "Changed candidate, ignored input or artifact invalidates proof"
        },
        {
          "id": "evidence.coverage",
          "expect": "Missing/skipped assertions and unmapped behaviors remain uncovered"
        },
        {
          "id": "evidence.coverage-integrity",
          "expect": "Changed maps, logs and unknown assertions are refused"
        }
      ]
    },
    {
      "id": "learning",
      "title": "Failure evaluations",
      "entryPoint": "alliance-work eval",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "learning.comparison",
          "expect": "Baseline and candidate use the same cases with durable evidence"
        },
        {
          "id": "learning.regressions",
          "expect": "Held-out regression or blocked baseline prevents an improvement claim"
        }
      ]
    },
    {
      "id": "maintenance",
      "title": "Safe activation",
      "entryPoint": "alliance-work update / rollback",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "maintenance.idle",
          "expect": "Active and unknown state blocks activation"
        },
        {
          "id": "maintenance.rollback",
          "expect": "Rollback retains auth, sessions and room artifacts; onto a release before 0.1.19 it builds that release's prompts, removes 0.1.19's handback-only records and sets each assignment that turns keeping its phase moved past its member's last turn back on that turn"
        },
        {
          "id": "maintenance.release-integrity",
          "expect": "Corrupt release rejected before activation"
        },
        {
          "id": "maintenance.wait-pause",
          "expect": "A waiting update pauses scheduled prompts only for each activation attempt, once a scheduler round confirms the pause; with --hold it keeps them paused from the end of staging through activation"
        },
        {
          "id": "maintenance.mutex",
          "expect": "One maintenance command runs per home; a waiting one pauses nothing and an interrupted one removes only its own locks"
        }
      ]
    },
    {
      "id": "operations",
      "title": "Owner and acceptance visibility",
      "entryPoint": "Alliance monitor / status / jobs / doctor",
      "preconditions": "Node 24 and isolated fixtures",
      "behaviors": [
        {
          "id": "operations.owner",
          "expect": "Owner changes and process tracking persist without sending prompts"
        },
        {
          "id": "operations.process",
          "expect": "Exited or reused PIDs never imply successful completion"
        },
        {
          "id": "operations.capabilities",
          "expect": "Missing coverage or changed pinned source fails health checks"
        },
        {
          "id": "operations.resume",
          "expect": "Unknown, archived and permission-blocked recipients receive no resume prompt; a closed session is reopened"
        }
      ]
    },
    {
      "id": "wakeups",
      "title": "Durable owner wakeups",
      "entryPoint": "wakeups CLI / native plugin RPC",
      "preconditions": "Isolated SQLite and native API fixtures",
      "behaviors": [
        {
          "id": "wakeups.persistence",
          "expect": "Restart keeps obligations and busy owners receive no prompt"
        },
        {
          "id": "wakeups.delivery",
          "expect": "Batching and ambiguous delivery never trigger an automatic resend; a send the daemon refused is retried"
        },
        {
          "id": "wakeups.repeat",
          "expect": "Pull delivery persists until acknowledged and repeats skip missed intervals"
        },
        {
          "id": "wakeups.turn",
          "expect": "Superseded or decided (accepted or rejected) work cannot wake an owner"
        },
        {
          "id": "wakeups.owner",
          "expect": "Unavailable owners hold delivery, closed owners are woken, a closed session that fails to load keeps its batch for later, and stale owner edits fail"
        },
        {
          "id": "wakeups.job",
          "expect": "Job exit never accepts results and owner changes require reconciliation"
        },
        {
          "id": "wakeups.recovery",
          "expect": "Interrupted claims are quarantined and expired work does not fire"
        },
        {
          "id": "wakeups.race",
          "expect": "Acceptance during owner readback prevents stale dispatch"
        },
        {
          "id": "wakeups.bounds",
          "expect": "Idle delivery bounds batch size and enforces owner cooldown"
        },
        {
          "id": "wakeups.decision",
          "expect": "A review is acknowledged only after a decision on its turn or a newer turn; deferral is bounded"
        },
        {
          "id": "wakeups.default",
          "expect": "Reminders wake their idle owner unless pull is chosen, never before a requested grace delay; older pull keys re-add unchanged"
        },
        {
          "id": "wakeups.visibility",
          "expect": "Pushed batches list pending pull reminders without claiming them; take returns unread reminders first"
        },
        {
          "id": "wakeups.pull-migration",
          "expect": "The first 0.1.19 load makes open pull reminders older releases stored wake their owner once, cancels those that came due over 72 hours earlier and keeps obligation reminders pull; later reminders keep the delivery they ask for"
        }
      ]
    },
    {
      "id": "obligations",
      "title": "Durable obligations and shared engineering laws",
      "entryPoint": "policy read / obligations / linked wakeups",
      "preconditions": "Node 24, isolated fixtures; external claims remain evidence-backed attestations",
      "behaviors": [
        {
          "id": "obligations.wait",
          "expect": "Due reminders wait for unexpired condition evidence; ack and TTL do not fulfill work"
        },
        {
          "id": "obligations.handoff",
          "expect": "Handoff and job ownership persist atomically across sessions and receipt expiry"
        },
        {
          "id": "obligations.autonomy",
          "expect": "Human waits, local-only scope and independent work remain valid without automatic sends"
        },
        {
          "id": "obligations.recovery",
          "expect": "Session recovery restores common policy and current open obligations without messaging owners; recovery snapshots and resume prompts list pending pull reminders"
        },
        {
          "id": "obligations.policy-size",
          "expect": "Role instructions stay within their word budget; Peer and Lens carry no owner duties"
        }
      ]
    },
    {
      "id": "autonomy",
      "title": "Autonomous assignment lifecycle",
      "entryPoint": "autonomy CLI / native lifecycle hooks and SDK",
      "preconditions": "Isolated SQLite and native API fixtures; model acceptance is separate",
      "behaviors": [
        {
          "id": "autonomy.continuation",
          "expect": "Idle unfinished work continues once; review wakes the owner without accepting"
        },
        {
          "id": "autonomy.retry",
          "expect": "Retries are bounded and cancellation/permissions hold execution"
        },
        {
          "id": "autonomy.uncertain",
          "expect": "Unknown dispatch survives reload without duplicate sending; a refused send is retried"
        },
        {
          "id": "autonomy.archive",
          "expect": "Only evidence-accepted idle work can archive"
        },
        {
          "id": "autonomy.reload",
          "expect": "Retained work continues after reopen while interrupted claims are quarantined"
        },
        {
          "id": "autonomy.race",
          "expect": "Pause during readback blocks sends and live native children block cascade"
        },
        {
          "id": "autonomy.obligations",
          "expect": "Prerequisites gate retries and continuations, and an obligation no longer open holds its bound assignment; handoff preserves budget, also to a member that only handed back; open obligations prevent archive"
        },
        {
          "id": "autonomy.handback",
          "expect": "A turn ending without a checkpoint is the handback when nothing else will wake the agent"
        },
        {
          "id": "autonomy.handback-only",
          "expect": "A member that only hands back to its owner is never continued and is retried only once at each provider limit's reset; each of its other turns, failed ones included, goes to the owner until an assignment is started"
        },
        {
          "id": "autonomy.reopened",
          "expect": "Prompts after a reopened handback or a quota retry do not repeat a reason that no longer applies"
        },
        {
          "id": "autonomy.quota",
          "expect": "A provider quota waits for its reset without using retries, at most three times in a row before it is blocked, and the owner hears of a long wait once; a short or unstated rate limit is retried within minutes"
        },
        {
          "id": "autonomy.self-started",
          "expect": "A turn Claude Code starts by itself keeps the phase it found and is neither continued nor retried, except, while its member waits, once at the reset of a provider limit it ended on; the handback it found stands with its review and decision, a decision may be recorded meanwhile, and a checkpoint in it is a new handback"
        },
        {
          "id": "autonomy.unchecked",
          "expect": "Two continuations in a row without a checkpoint hand the final message to the owner instead of a third"
        },
        {
          "id": "autonomy.review-failure",
          "expect": "A failure after a review checkpoint in the same turn keeps the handback for review"
        },
        {
          "id": "autonomy.blocked",
          "expect": "Exhausted budgets request review and only a start renews them; a new turn keeps a block until the agent checkpoints or is started, an explicit blocker is kept, and a blocker asks its owner once"
        },
        {
          "id": "autonomy.prompts",
          "expect": "Continuation and review prompts name the current CLI and the agent's pending pull reminders"
        }
      ]
    },
    {
      "id": "lifecycle",
      "title": "Decision-driven close and fleet deploy",
      "entryPoint": "accept / status lifecycle / Lifecycle sweep / update --bundle / deploy",
      "preconditions": "Isolated SQLite, fake native API and local shell fixtures; real-model and fleet runs are separate",
      "behaviors": [
        {
          "id": "lifecycle.authority",
          "expect": "Only the responsible owner chain or the Human decides; self-acceptance is refused"
        },
        {
          "id": "lifecycle.scope",
          "expect": "Peers close on technical acceptance; coordinating roles need product acceptance or the Human"
        },
        {
          "id": "lifecycle.legacy",
          "expect": "Accepted sessions from before autonomy archive by role and recorded scope"
        },
        {
          "id": "lifecycle.pause",
          "expect": "A resumed turn lifts a cancellation; a checkpoint pause holds after acceptance"
        },
        {
          "id": "lifecycle.stale",
          "expect": "Undecided completed handbacks wake their owner once after 48h, never the Human, without upgrade bursts"
        },
        {
          "id": "lifecycle.retention",
          "expect": "Finished wakeups expire after retention while current turn reminders keep their key"
        },
        {
          "id": "lifecycle.deploy",
          "expect": "Bundles are checksum-verified and handed to the installed launcher with the wait option; a host older than 0.1.19 waits with the candidate's own CLI"
        },
        {
          "id": "lifecycle.owned",
          "expect": "Members with a live member owner get an assignment; a recent undecided handback wakes the nearest live owner, an older one the 48h reminder"
        },
        {
          "id": "lifecycle.reask",
          "expect": "A delivered review left undecided for 48 hours is asked again once"
        },
        {
          "id": "lifecycle.archived-owner",
          "expect": "An archived owner's reminders and reviews end; none moves up the chain"
        },
        {
          "id": "lifecycle.hold",
          "expect": "Only a Human's cancel holds pushed reminders; an owner that paused itself still gets them and the turn they start keeps its pause"
        },
        {
          "id": "lifecycle.at-rest",
          "expect": "Running work, pending wakeups and permissions hold an accepted agent open; a closed session is at rest"
        }
      ]
    }
  ],
