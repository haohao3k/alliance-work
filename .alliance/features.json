{
  "version": 1,
  "features": [
    {
      "id": "rooms",
      "title": "Rooms and delegation",
      "entryPoint": "Native room creation / create_agent",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "rooms.room-binding",
          "expect": "Native sessions bind the same project room across restart"
        },
        {
          "id": "rooms.assignment",
          "expect": "Retried launches preserve one agent and durable assignment"
        },
        {
          "id": "rooms.ownership",
          "expect": "Cancel/failure/completion preserve ownership without automatic acceptance"
        },
        {
          "id": "rooms.resume",
          "expect": "Resume does not interrupt active work or accept late receipts"
        }
      ]
    },
    {
      "id": "models",
      "title": "Owner model choice",
      "entryPoint": "Room Models settings",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "models.lead-choice",
          "expect": "Lead can override preferred model and effort"
        },
        {
          "id": "models.worker-policy",
          "expect": "Worker choices respect allowlist and owner choice"
        },
        {
          "id": "models.policy-persistence",
          "expect": "Policies persist and reject stale edits"
        }
      ]
    },
    {
      "id": "skills",
      "title": "Project skills",
      "entryPoint": "alliance-work skills add",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "skills.skill-selection",
          "expect": "Only explicitly registered project skills and resources load"
        }
      ]
    },
    {
      "id": "evidence",
      "title": "Bound acceptance",
      "entryPoint": "alliance-work verify / accept",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "evidence.evidence-binding",
          "expect": "Changed candidate, ignored input or artifact invalidates proof"
        },
        {
          "id": "evidence.coverage",
          "expect": "Missing/skipped assertions and unmapped behaviors remain uncovered"
        },
        {
          "id": "evidence.coverage-integrity",
          "expect": "Changed maps, logs and unknown assertions are refused"
        }
      ]
    },
    {
      "id": "learning",
      "title": "Failure evaluations",
      "entryPoint": "alliance-work eval",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "learning.comparison",
          "expect": "Baseline and candidate use the same cases with durable evidence"
        },
        {
          "id": "learning.regressions",
          "expect": "Held-out regression or blocked baseline prevents an improvement claim"
        }
      ]
    },
    {
      "id": "maintenance",
      "title": "Safe activation",
      "entryPoint": "alliance-work update / rollback",
      "preconditions": "Node 24 and npm ci; isolated test fixtures",
      "behaviors": [
        {
          "id": "maintenance.idle",
          "expect": "Active and unknown state blocks activation"
        },
        {
          "id": "maintenance.rollback",
          "expect": "Rollback retains auth, sessions and room artifacts"
        },
        {
          "id": "maintenance.release-integrity",
          "expect": "Corrupt release rejected before activation"
        }
      ]
    },
    {
      "id": "operations",
      "title": "Owner and acceptance visibility",
      "entryPoint": "Alliance monitor / status / jobs / doctor",
      "preconditions": "Node 24 and isolated fixtures",
      "behaviors": [
        {
          "id": "operations.owner",
          "expect": "Owner changes and process tracking persist without sending prompts"
        },
        {
          "id": "operations.process",
          "expect": "Exited or reused PIDs never imply successful completion"
        },
        {
          "id": "operations.capabilities",
          "expect": "Missing coverage or changed pinned source fails health checks"
        },
        {
          "id": "operations.resume",
          "expect": "Unknown and closed recipients receive no resume prompt"
        }
      ]
    },
    {
      "id": "wakeups",
      "title": "Durable owner wakeups",
      "entryPoint": "wakeups CLI / native plugin RPC",
      "preconditions": "Isolated SQLite and native API fixtures",
      "behaviors": [
        {
          "id": "wakeups.persistence",
          "expect": "Restart keeps obligations and busy owners receive no prompt"
        },
        {
          "id": "wakeups.delivery",
          "expect": "Batching and ambiguous delivery never trigger an automatic resend"
        },
        {
          "id": "wakeups.repeat",
          "expect": "Pull delivery persists until acknowledged and repeats skip missed intervals"
        },
        {
          "id": "wakeups.turn",
          "expect": "Superseded or accepted work cannot wake an owner"
        },
        {
          "id": "wakeups.owner",
          "expect": "Unavailable owners hold delivery and stale owner edits fail"
        },
        {
          "id": "wakeups.job",
          "expect": "Job exit never accepts results and owner changes require reconciliation"
        },
        {
          "id": "wakeups.recovery",
          "expect": "Interrupted claims are quarantined and expired work does not fire"
        },
        {
          "id": "wakeups.race",
          "expect": "Acceptance during owner readback prevents stale dispatch"
        },
        {
          "id": "wakeups.bounds",
          "expect": "Idle delivery bounds batch size and enforces owner cooldown"
        }
      ]
    },
    {
      "id": "obligations",
      "title": "Durable obligations and shared engineering laws",
      "entryPoint": "policy read / obligations / linked wakeups",
      "preconditions": "Node 24, isolated fixtures; external claims remain evidence-backed attestations",
      "behaviors": [
        {
          "id": "obligations.wait",
          "expect": "Due reminders wait for unexpired condition evidence; ack and TTL do not fulfill work"
        },
        {
          "id": "obligations.handoff",
          "expect": "Handoff and job ownership persist atomically across sessions and receipt expiry"
        },
        {
          "id": "obligations.autonomy",
          "expect": "Human waits, local-only scope and independent work remain valid without automatic sends"
        },
        {
          "id": "obligations.recovery",
          "expect": "Session recovery restores common policy and current open obligations without messaging owners"
        }
      ]
    }
  ],
  "scenarios": [
    {
      "id": "rooms.room-binding",
      "command": ["$NODE", "scripts/verify-contract.mjs", "rooms.room-binding"],
      "assertions": [
