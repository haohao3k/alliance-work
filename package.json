{
  "name": "alliance-work",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Autonomous rooms and isolated agent homes on native Paseo",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:homes": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "ALLIANCE_NATIVE_TESTS=1 node --import tsx --test tests/native-homes.test.ts",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "check": "npm run verify:vendor && npm run typecheck && npm test",
    "release:pack": "node scripts/release.mjs",
    "test:maintenance": "ALLIANCE_NATIVE_PASEO_TESTS=1 node --import tsx --test tests/paseo-maintenance.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@getpaseo/cli": "0.10.3",
    "@getpaseo/client": "0.10.3",
    "@getpaseo/plugin": "0.10.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "bin": {
    "alliance-work": "scripts/cli.mjs"
  }
}
